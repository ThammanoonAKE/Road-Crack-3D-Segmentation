# Production builds (Vercel, `next build`) load the reconstructions from this Cloudflare R2 bucket instead of
# public/splats. `next dev` does not read this file and keeps using the local files.
# To build against the local files, put NEXT_PUBLIC_SPLAT_BASE_URL=/splats in .env.local.
NEXT_PUBLIC_SPLAT_BASE_URL=https://pub-5f4039b2d4cc4cafbe8e93d80752f2a5.r2.dev/splats

# The deployed address, for absolute Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=https://road-crack-3-d-segmentation.vercel.app

# The public repository: linked from the method section and the footer.
NEXT_PUBLIC_REPO_URL=https://github.com/ThammanoonAKE/Road-Crack-3D-Segmentation

# The crack detector of /detect (edge_ai/onnx_web.py writes it; 110 MB), in the same bucket. Without this the page
# looks for it in public/models, which is not committed.
NEXT_PUBLIC_DETECTOR_URL=https://pub-5f4039b2d4cc4cafbe8e93d80752f2a5.r2.dev/models/deepcrack_1class_2026-11-20.web.onnx
