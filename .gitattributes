# Auto detect text files and perform LF normalization
* text=auto

# Large binaries go through Git LFS (GitHub refuses files over 100 MB; two splats and both model weights are larger).
*.ksplat filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
# The website's own clip is 5 MB and stays in git: hosts that build from the repository without Git LFS
# (Vercel by default) would otherwise publish the LFS pointer instead of the video.
web/public/media/video/*.mp4 -filter -diff -merge -text

# Small binaries stay in git.
*.bin binary
*.jpg binary
*.png binary

# Windows scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
